10 REM Loops, IF/THEN/ELSE and GOSUB
20 CLS
30 FOR N = 1 TO 15
40 IF N - INT (N / 3) * 3 = 0 THEN GOSUB 100
50 IF N - INT (N / 5) * 5 = 0 THEN GOSUB 200
60 IF N - INT (N / 3) * 3 <> 0 AND N - INT (N / 5) * 5 <> 0 THEN PRINT N
70 NEXT N
80 PRINT "BYE"
90 STOP
100 PRINT "FIZZ"
110 RETURN
200 PRINT "BUZZ"
210 RETURN
